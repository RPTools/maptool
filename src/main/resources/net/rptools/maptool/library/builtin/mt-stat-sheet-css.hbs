  --mt-focus-outline: var(--mt-border-width) solid var(--mt-theme-component-focused-border-color);
  --mt-map-label-border-radius: calc(var(--mt-prefs-map-label-border-arc)/2 * 1px); /* border-radius = 1/2 border arc */

  font-size: var(--mt-theme-font-size);
  font-family: var(--mt-theme-font-family);
