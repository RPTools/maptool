/* =========================
   02. Base Elements
   ========================= */

body {
  position: fixed;
  left: 0;
  bottom: 0;
  padding: 0px;
  margin: 0px;
  background-color: rgba(0, 0, 0, 0); /* Needs to be transparent. */
}

p,
table,
input {
   vertical-align: middle;
   font-size: 1rem;
}


/* =========================
   03. Typography
   ========================= */

/* Headings. */
h1 {
  font-family: var(--mt-theme-h1-font-family);
  font-size: var(--mt-theme-h1-font-size);
}

h2 {
  font-family: var(--mt-theme-h2-font-family);
  font-size: var(--mt-theme-h2-font-size);
}

h3 {
  font-family: var(--mt-theme-h3-font-family);
  font-size: var(--mt-theme-h3-font-size);
}

h4 {
  font-family: var(--mt-theme-h4-font-family);
  font-size: var(--mt-theme-h4-font-size);
}

h5 {
  font-family: var(--mt-theme-h5-font-family);
  font-size: var(--mt-theme-h5-font-size);
}

h6 {
  font-family: var(--mt-theme-h6-font-family);
  font-size: var(--mt-theme-h6-font-size);
}

h1, h2, h3, h4, h5, h6 { margin-bottom: .5rem; }


/* =========================
   04. Input Controls
   ========================= */

/* Text input */
input[type=text],
textarea {
  font-family: inherit;
  color: var(--mt-theme-color-text-input-foreground);
  background-color: var(--mt-theme-color-text-input-background);
  border: var(--mt-theme-color-text-input-disabled-border-size) solid var(--mt-theme-color-text-input-disabled-border-color);
}

/* Input = Checkbox */
input[type=checkbox] {
  -webkit-appearance: none;
  appearance: none;
  width: 1.2em;
  height: 1.2em;
  color: var(--mt-theme-check-box-foreground-color);
  background-color: var(--mt-theme-check-box-background-color);
  border: var(--mt-border-width) solid var(--mt-theme-check-box-border-color);
  border-radius: .15em;
  box-sizing: border-box;

  /* Center the checkmark */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Pure CSS checkmark */
input[type="checkbox"]::after {
  content: "";
  width: 0.25em;
  height: 0.65em;
  border: solid var(--mt-theme-check-box-foreground-color);
  border-width: 0 0.2em 0.2em 0;
  transform: translate(0.05em, -0.05em) rotate(40deg);
  transform-origin: center;
  flex-shrink: 0;
  display: none;
}

input[type="checkbox"]:checked::after {
  display: block;
}


/* =========================
   05. Scrollbars
   ========================= */

::-webkit-scrollbar {
  background-color: var(--mt-theme-scroll-bar-background-color);
}

::-webkit-scrollbar:vertical {
  width: var(--mt-theme-scroll-bar-width);
}

::-webkit-scrollbar:horizontal {
  height: var(--mt-theme-scroll-bar-width);  /* intentionally using the scroll bar width for the height */
}

::-webkit-scrollbar-button {
  display: none;
}

::-webkit-scrollbar-corner {
  background-color: transparent;
}

::-webkit-scrollbar-thumb {
  background-color: var(--mt-theme-scroll-bar-thumb-color);
  border-style: solid;
  border-color: transparent;
  border-radius: calc(var(--mt-theme-scroll-bar-thumb-arc)/2 * 1px);
  background-clip: padding-box;  /* insets workaround given that ::-webkit-scrollbar-thumb does not support padding */
}

::-webkit-scrollbar-thumb:vertical {
  border-width:
    calc(var(--mt-theme-scroll-bar-thumb-insets-top) * 1px)
    calc(var(--mt-theme-scroll-bar-thumb-insets-right) * 1px)
    calc(var(--mt-theme-scroll-bar-thumb-insets-bottom) * 1px)
    calc(var(--mt-theme-scroll-bar-thumb-insets-left) * 1px);
}

::-webkit-scrollbar-thumb:horizontal {
  /* swap the variable order to match the horizontal axis layout */
  border-width:
    calc(var(--mt-theme-scroll-bar-thumb-insets-left) * 1px)
    calc(var(--mt-theme-scroll-bar-thumb-insets-top) * 1px)
    calc(var(--mt-theme-scroll-bar-thumb-insets-right) * 1px)
    calc(var(--mt-theme-scroll-bar-thumb-insets-bottom) * 1px);
}

::-webkit-scrollbar-track {
  background-color: var(--mt-theme-scroll-bar-track-color);
  border-style: solid;
  border-color: transparent;
  border-radius: calc(var(--mt-theme-scroll-bar-track-arc)/2 * 1px); /* border-radius = 1/2 border arc */
  background-clip: padding-box;  /* insets workaround given that ::-webkit-scrollbar-track does not support padding */
}

::-webkit-scrollbar-track:vertical {
  border-width:
    calc(var(--mt-theme-scroll-bar-track-insets-top) * 1px)
    calc(var(--mt-theme-scroll-bar-track-insets-right) * 1px)
    calc(var(--mt-theme-scroll-bar-track-insets-bottom) * 1px)
    calc(var(--mt-theme-scroll-bar-track-insets-left) * 1px);
}

::-webkit-scrollbar-track:horizontal {
  /* swap the variable order to match the horizontal axis layout */
  border-width:
    calc(var(--mt-theme-scroll-bar-track-insets-left) * 1px)
    calc(var(--mt-theme-scroll-bar-track-insets-top) * 1px)
    calc(var(--mt-theme-scroll-bar-track-insets-right) * 1px)
    calc(var(--mt-theme-scroll-bar-track-insets-bottom) * 1px);
}


/* =========================
   06. Other Elements
   ========================= */

/* Fieldset */
fieldset {
  font-size: 1em;
  padding: 0.5em;
  border: var(--mt-border-default);
  border-radius: 0.15em;
  margin: 0.5em;
}

fieldset > legend {
  font-family: inherit;
  color: var(--mt-theme-component-link-color);
}

/* Horizontal Rule */
hr {
  border: none;
  height: 1px;
  background: var(--mt-theme-color-button-disabled-border-color);
  margin: 1rem 0;
}

/* Meter */
meter {
  -webkit-appearance: none;
  appearance: none;
}

meter::-webkit-meter-bar {
  background: var(--mt-theme-meter-progress-bar-background-color);
  border: none;
}

meter::-webkit-meter-optimum-value,
meter::-webkit-meter-suboptimum-value,
meter::-webkit-meter-even-less-good-value {
  background: var(--mt-theme-meter-progress-bar-foreground-color);
}


/* Progress Bar */
progress {
  -webkit-appearance: none;
  appearance: none;
}

progress::-webkit-progress-bar {
  background-color: var(--mt-theme-progress-bar-background-color);
  border-radius: calc(var(--mt-theme-progress-bar-arc) * 1px); /* border-radius = 1/2 border arc */
}

progress::-webkit-progress-value {
  background-color: var(--mt-theme-progress-bar-foreground-color);
}


/* =========================
   07. Ids & Classes
   ========================= */

#statSheet {
  background-color: var(--mt-theme-color-background);
  color: var(--mt-theme-color-foreground);
  position: fixed;
  padding: 10px;
  margin: 0px;
}

.statSheet-topLeft {
  position: fixed;
  left: 0px;
  top: 0px;
}

.statSheet-topRight {
  position: fixed;
  right: 0px;
  top: 0px;
}

.statSheet-bottomLeft {
  position: fixed;
  left: 0px;
  bottom: 0px;
}

.statSheet-bottomRight {
  position: fixed;
  right: 0px;
  bottom: 0px;
}

.statSheet-top {
  position: fixed;
  left: 50%;
  top: 0px;
  transform: translate(-50%, 0);
}

.statSheet-bottom {
  position: fixed;
  left: 50%;
  bottom: 0px;
  transform: translate(-50%, 0);
}

.statSheet-left {
  position: fixed;
  left: 0px;
  top: 50%;
  transform: translate(0, -50%);
}

.statSheet-right {
  position: fixed;
  right: 0px;
  top: 50%;
  transform: translate(0, -50%);
}

.mt-map-label {
  display: inline-block;
  border-width: {{#if preferences.mapLabelShowBorder}}var(--mt-prefs-map-label-border-width){{else}}0{{/if}};
  border-style: solid;
  border-color: transparent;
  border-radius: var(--mt-map-label-border-radius);
  font-size: var(--mt-prefs-map-label-font-size);
  padding: 4px;
  margin: 1px;
  text-align: center;
}

.mt-map-label-pc {
  background: var(--mt-prefs-map-label-pc-background-color) !important;
  border-color: var(--mt-prefs-map-label-pc-border-color) !important;
  color: var(--mt-prefs-map-label-pc-foreground-color) !important;
}

.mt-map-label-npc {
  background: var(--mt-prefs-map-label-npc-background-color) !important;
  border-color: var(--mt-prefs-map-label-npc-border-color) !important;
  color: var(--mt-prefs-map-label-npc-foreground-color) !important;
}

.mt-map-label-non-visible {
  background: var(--mt-prefs-map-label-non-visible-background-color) !important;
  border: var(--mt-prefs-map-label-non-visible-border-color) !important;
  color: var(--mt-prefs-map-label-non-visible-foreground-color) !important;
}

.mt-map-label-drawing {
  background: var(--mt-prefs-map-label-drawing-background-color) !important;
  border-color: var(--mt-prefs-map-label-drawing-border-color) !important;
  color: var(--mt-prefs-map-label-drawing-foreground-color) !important;
}

.mt-map-label-template {
  background: var(--mt-prefs-map-label-template-background-color) !important;
  border-color: var(--mt-prefs-map-label-template-border-color) !important;
  color: var(--mt-prefs-map-label-template-foreground-color) !important;
}